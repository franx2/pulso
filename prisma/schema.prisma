generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migraciones, no la app: la pooled (PgBouncer) no soporta el estado de
  // sesión que Prisma Migrate necesita. Sólo existe en Vercel/Neon; en
  // Railway (túnel SSH local) no está seteada y Prisma cae de nuevo a `url`.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Rol {
  ADMIN
  ENCARGADO
  EMPLEADO
}

enum TipoFichaje {
  ENTRADA
  SALIDA
  DESCANSO_INICIO
  DESCANSO_FIN
}

enum TipoAlerta {
  NO_FICHO
  LLEGADA_TARDE
  SALIDA_OLVIDADA
  EXCESO_HORARIO
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TipoCorreccion {
  AGREGAR
  MODIFICAR
  ELIMINAR
}

enum TipoAusencia {
  VACACIONES
  ENFERMEDAD
  FRANCO
  LICENCIA
  FALTA
  OTRO
}

/// Un local dentro de un shopping no siente la lluvia como uno a la calle.
/// El modelo NO asume cuánto: usa esto para aprender la sensibilidad real de
/// cada tipo con los datos (ver `lib/forecast/clima.ts`).
enum TipoLocal {
  INDOOR_MALL
  OPEN_AIR
}

/// Sectores operativos para los que se calcula carga y dotación. Se mapean
/// desde las categorías de empleado que ya existen por local (`Categoria`).
enum Sector {
  COCINA
  SALON
  CAJA
  DESPACHO
  ENCARGADO
}

enum OrigenParametro {
  /// Valor por defecto, todavía sin evidencia propia del local.
  DEFECTO
  /// Calculado por el sistema a partir del histórico.
  APRENDIDO
  /// Fijado a mano por un administrador: gana sobre los otros dos.
  MANUAL
}

enum VerificacionRostro {
  /// La cara coincidió con la registrada.
  OK
  /// Se detectó una cara pero no es la registrada.
  NO_COINCIDE
  /// La cámara no encontró ninguna cara.
  SIN_ROSTRO
  /// El empleado todavía no registró su cara.
  NO_REGISTRADO
  /// Sin cámara o permiso denegado: se fichó sin verificar.
  OMITIDA
}

model Local {
  id          String     @id @default(cuid())
  nombre      String
  lat         Float?
  lng         Float?
  radioMetros Int        @default(150)

  /// Si el descanso se resta de las horas trabajadas o se paga igual.
  descuentaDescanso Boolean @default(true)
  /// Minutos de gracia antes de marcar una llegada como tardanza.
  toleranciaMin     Int     @default(10)
  /// Horas semanales a partir de las cuales el excedente es hora extra.
  topeSemanalHoras  Float   @default(48)

  /// Exigir control de rostro por cámara al fichar.
  verificarRostro   Boolean @default(false)
  /// Distancia euclídea máxima para dar por buena la cara. El estándar del
  /// modelo es 0.6; más bajo es más estricto y rechaza más caras legítimas.
  /// Es un botón de calibración: cocina con vapor y gorro necesita más margen.
  rostroTolerancia  Float   @default(0.55)

  /// Multiplicador de precio/hora en un día feriado (el calendario es único
  /// para todo el negocio, pero cada local puede pagarlo distinto).
  multiplicadorFeriado Float @default(2)

  /// Credenciales de la cuenta de Fudo DE ESTE LOCAL (cada sucursal es una
  /// cuenta separada). Null hasta que el admin las carga. Nunca se devuelven
  /// en una respuesta de API — sólo se usan server-side para sincronizar.
  fudoApiKey    String?
  fudoApiSecret String?
  /// Último sync exitoso del mapa de calor de demanda. Null si nunca corrió.
  demandaSincronizadaEn DateTime?
  /// Último sync exitoso del resumen diario que alimenta el dashboard.
  resumenSincronizadoEn DateTime?

  /// Expuesto o no al clima. Sin esto, el modelo no puede separar por qué un
  /// día de lluvia mueve a un local y al otro no.
  tipoLocal TipoLocal @default(OPEN_AIR)

  empleados   Empleado[]        @relation("LocalPrincipal")
  asignados   AsignacionLocal[]
  turnos      Turno[]
  fichajes    Fichaje[]
  alertas     Alerta[]
  horarios    HorarioLocal[]
  categorias  Categoria[]
  demandas    DemandaHoraria[]
  resumenes   ResumenDiario[]
  stocks      StockDiario[]
  productosDiarios ProductoDiario[]
  demandaSlots     DemandaSlot[]
  coeficientesSector CoeficienteSector[]
  coeficientesCanal  CoeficienteCanal[]
  capacidades      CapacidadSector[]
  ajustesK         AjusteK[]
  climas           ClimaDia[]
  pronosticos      Pronostico[]
}

/// Patrón histórico de demanda (ventas promedio por día de semana y hora),
/// cargado a mano desde un análisis de ventas del punto de venta. Se
/// superpone al Gantt semanal de turnos para ayudar a planificar dotación.
/// No se sincroniza en vivo con ningún POS.
model DemandaHoraria {
  id         String @id @default(cuid())
  local      Local  @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId    String
  diaSemana  Int
  hora       Int
  /// Promedio de ventas cerradas en esa franja, sobre las semanas de la
  /// muestra (no es un total acumulado).
  ventasProm Float

  @@unique([localId, diaSemana, hora])
}

/// Una fila por local y día calendario (hora argentina), armada desde Fudo.
/// El dashboard lee de acá y no de la API: un año de ventas son ~200 páginas
/// paginadas, imposible de esperar en pantalla; además las alertas necesitan
/// historia para comparar contra el promedio.
model ResumenDiario {
  id       String   @id @default(cuid())
  local    Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId  String
  fecha    DateTime @db.Date

  ventas      Float @default(0)
  /// Ventas cerradas del día (tickets).
  tickets     Int   @default(0)
  /// Suma de `people` de las ventas que lo traen (sólo salón; delivery y
  /// takeaway vienen sin el dato).
  personas    Int   @default(0)
  descuentos  Float @default(0)
  /// Facturación de las ventas anuladas (no está incluida en `ventas`).
  anulaciones Float @default(0)
  /// Gastos cargados en Fudo ese día (proveedores, servicios, retiros).
  gastos      Float @default(0)

  /// Costo de lo vendido, sumando el costo cargado en cada producto. Fudo
  /// deja el costo en null cuando no lo cargaron: `costoIncompleto` avisa que
  /// el margen que sale de acá es optimista, en vez de mostrarlo como cierto.
  costo           Float   @default(0)
  costoIncompleto Boolean @default(false)

  /// {"Efectivo": 12345, "Tarj. Débito": 6789, ...}
  porMedioPago Json?
  /// {"EAT-IN": 12345, "TAKEAWAY": 6789, "DELIVERY": 0}
  porCanal     Json?
  /// {"CAFETERIA": 12345, "BEBIDAS Y JUGOS": 6789, ...}
  porCategoria Json?
  /// Descuentos por caja — en esta cuenta de Fudo cada caja es una persona,
  /// así que esto responde "quién descontó": {"Antonella": 12345}
  descuentosPorCaja Json?
  /// [{"nombre": "PROMO LAMINATO", "cantidad": 12, "facturacion": 117600}]
  topProductos Json?

  actualizadoEn DateTime @updatedAt

  @@unique([localId, fecha])
  @@index([localId, fecha])
}

/// Una fila por producto vendido, por local y por día. `ResumenDiario` guarda
/// sólo el top del día, que alcanza para "qué se vende" pero no para lo que
/// pide un análisis serio: los que MENOS salen, el mismo producto comparado
/// entre sucursales, o un rango de fechas cualquiera.
model ProductoDiario {
  id      String   @id @default(cuid())
  local   Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String
  fecha   DateTime @db.Date

  fudoProductoId String
  /// Desnormalizados: el histórico no puede depender de que el producto siga
  /// existiendo en Fudo, ni de que la categoría no se haya renombrado.
  producto       String
  categoria      String?

  cantidad    Float
  facturacion Float
  /// Costo de lo vendido según el costo cargado en Fudo (0 si no lo cargaron).
  costo       Float @default(0)

  @@unique([localId, fecha, fudoProductoId])
  @@index([localId, fecha])
  @@index([producto])
}

/// Foto diaria del stock de cada producto, para tener la serie que la API de
/// Fudo no guarda (devuelve el stock de ahora, no su historia).
///
/// Fudo descuenta el stock con cada venta, así que en un día sin recepciones
/// ni ajustes vale: stock_hoy = stock_ayer − vendido. `movimientoNoExplicado`
/// es lo que sobra de esa cuenta: mercadería que entró, un recuento a mano, o
/// una pérdida. Ese es el número accionable mientras nadie cargue las compras
/// en Fudo; el día que se carguen, la serie ya está y el desvío se vuelve un
/// "debería haber vs. hay" de verdad.
model StockDiario {
  id       String   @id @default(cuid())
  local    Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId  String
  fecha    DateTime @db.Date

  fudoProductoId String
  /// Desnormalizado a propósito: el reporte histórico no puede depender de
  /// que el producto siga existiendo (o llamándose igual) en Fudo.
  producto       String

  stock       Float
  stockPrevio  Float?
  /// Unidades vendidas ese día, contadas desde los items de las ventas.
  vendido     Float @default(0)
  movimientoNoExplicado Float?

  actualizadoEn DateTime @updatedAt

  @@unique([localId, fecha, fudoProductoId])
  @@index([localId, fecha])
}

// ─────────────────────────────────────────────────────────────────────────
// Módulo de pronóstico de demanda y dotación.
// La serie de 30 minutos es la base de todo: ni ResumenDiario (día) ni
// DemandaHoraria (promedio día-de-semana × hora, sin fecha) sirven para
// pronosticar, porque ninguno es una serie temporal real.
// ─────────────────────────────────────────────────────────────────────────

/// Una fila por local, día y franja de 30 minutos (slot 0 = 00:00-00:30 hora
/// argentina, slot 47 = 23:30-24:00). Guarda medidas crudas, no carga: la
/// carga depende de coeficientes editables y se calcula al leer, así cambiar
/// la matriz no obliga a re-sincronizar tres meses.
model DemandaSlot {
  id      String   @id @default(cuid())
  local   Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String
  fecha   DateTime @db.Date
  /// 0..47
  slot    Int

  tickets  Int   @default(0)
  /// Unidades vendidas (ítems), que pesan más que la plata para la carga.
  unidades Float @default(0)
  ventas   Float @default(0)
  /// Comensales declarados (sólo salón; delivery/takeaway vienen sin dato).
  personas Int   @default(0)

  /// {"EAT-IN": 12, "TAKEAWAY": 4, "DELIVERY": 2} — tickets por canal.
  porCanal     Json?
  /// {"cafeteria": 18, "panificados": 6} — unidades por categoría canónica.
  porCategoria Json?

  @@unique([localId, fecha, slot])
  @@index([localId, fecha])
}

/// Matriz categoría × sector: cuánta carga genera una unidad de esa categoría
/// en ese sector. Es el punto 9 del pedido y arranca con valores por defecto
/// razonables, marcados como DEFECTO para que se vea que todavía no se
/// aprendieron. Una fila con `localId` gana sobre la global (`localId` null).
model CoeficienteSector {
  id        String  @id @default(cuid())
  local     Local?  @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId   String?
  /// Categoría canónica (ver lib/forecast/categorias.ts), no el nombre crudo
  /// de Fudo: los locales escriben la misma categoría de cuatro formas.
  categoria String
  sector    Sector
  coeficiente Float
  origen    OrigenParametro @default(DEFECTO)

  @@unique([localId, categoria, sector])
  @@index([categoria])
}

/// Carga que agrega un ticket por el solo hecho de existir, según su canal
/// (atender una mesa cuesta aunque el pedido sea chico; un delivery ocupa
/// despacho). Separado de la matriz de productos a propósito.
model CoeficienteCanal {
  id          String  @id @default(cuid())
  local       Local?  @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId     String?
  canal       String
  sector      Sector
  coeficiente Float
  origen      OrigenParametro @default(DEFECTO)

  @@unique([localId, canal, sector])
}

/// Cuánta carga por hora absorbe una persona en un sector. Es lo que traduce
/// carga en dotación, y hoy NO se puede aprender: hay 34 fichajes en total.
/// Por eso arranca en DEFECTO con la confianza en el piso, y el motor lo dice
/// en la salida en vez de presentar la dotación como si fuera medida.
model CapacidadSector {
  id      String @id @default(cuid())
  local   Local  @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String
  sector  Sector

  /// Puntos de SectorLoadScore por hora y por persona.
  capacidadPorEmpleado Float
  minPersonas          Int    @default(0)
  maxPersonas          Int    @default(10)
  origen               OrigenParametro @default(DEFECTO)
  /// 0..1. Sube a medida que hay fichajes reales contra los que calibrar.
  confianza            Float  @default(0.2)
  /// Cuántas observaciones (franja × día con dotación conocida) respaldan el
  /// valor. Con 0, la capacidad es un supuesto declarado, no un aprendizaje.
  observaciones        Int    @default(0)

  @@unique([localId, sector])
}

/// Ajuste manual de demanda (K_manual). Ámbito de menor a mayor precedencia:
/// local → día de semana → fecha puntual → franja. Por defecto no existe
/// ninguna fila y K_manual vale 1.
model AjusteK {
  id      String  @id @default(cuid())
  local   Local?  @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String?
  /// 0..6 (domingo=0), null si no aplica.
  diaSemana Int?
  /// Fecha puntual (un evento, un corte de calle), null si no aplica.
  fecha     DateTime? @db.Date
  /// Franja de 30 min, null = todo el día.
  slot      Int?

  valor  Float
  motivo String?

  @@index([localId, fecha])
}

/// Sensibilidad al clima aprendida por tipo de local. Es el punto 19: en vez
/// de asumir "llueve → -18%", se mide contra el histórico y se guarda con su
/// confianza y con cuántos días la respaldan.
model SensibilidadClima {
  id        String    @id @default(cuid())
  tipoLocal TipoLocal
  /// "LLUVIA", "FRIO", "CALOR"
  condicion String
  /// Multiplicador medido sobre la demanda normal (1 = sin efecto).
  factor    Float
  confianza Float     @default(0)
  /// Días de historia que respaldan el factor.
  dias      Int       @default(0)
  origen    OrigenParametro @default(DEFECTO)
  calculadoEn DateTime @updatedAt

  @@unique([tipoLocal, condicion])
}

/// Clima por local y día. Histórico para aprender, pronóstico para proyectar.
/// Sin coordenadas cargadas en el local no hay clima, y el motor lo trata
/// como factor neutro en vez de inventarlo.
model ClimaDia {
  id      String   @id @default(cuid())
  local   Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String
  fecha   DateTime @db.Date

  tempMax  Float?
  tempMin  Float?
  lluviaMm Float?
  vientoKmh Float?
  /// true cuando viene del pronóstico y todavía no del histórico.
  esPronostico Boolean @default(false)

  @@unique([localId, fecha])
}

/// Forecast guardado. Nunca se borra: sin el histórico de pronósticos no se
/// puede saber si el modelo está mejorando (punto 16). Cuando llega el dato
/// real se completa `real*` y el error, en la misma fila.
model Pronostico {
  id      String   @id @default(cuid())
  local   Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String
  fecha   DateTime @db.Date
  /// null = fila del día completo; 0..47 = franja de 30 minutos.
  slot    Int?

  /// Cuándo se emitió: dos pronósticos de la misma fecha hechos en momentos
  /// distintos no son el mismo pronóstico.
  emitidoEn DateTime @default(now())

  demandaBase   Float
  kAuto         Float
  kManual       Float @default(1)
  demandaFinal  Float
  /// {"K_calendar":1.18,"K_weather":1.06,...} para poder explicarlo.
  kDetalle      Json?

  ticketsPronosticados Float
  unidadesPronosticadas Float
  ventasPronosticadas  Float
  /// Índice normalizado: 100 = demanda normal de ESE local en ESA franja.
  demandIndex          Float

  /// Intervalo de confianza sobre tickets.
  ticketsMin Float?
  ticketsMax Float?
  confianza  Float?

  /// {"COCINA": 3, "SALON": 2, ...}
  cargaPorSector    Json?
  dotacionPorSector Json?

  /// Se completan cuando llega el día.
  ticketsReales  Float?
  ventasReales   Float?
  errorTickets   Float?

  @@unique([localId, fecha, slot, emitidoEn])
  @@index([localId, fecha])
}

/// Calendario nacional de feriados, único para todo el negocio (cada local
/// paga su multiplicador propio sobre estos días, ver `Local.multiplicadorFeriado`).
model Feriado {
  id     String   @id @default(cuid())
  fecha  DateTime @unique @db.Date
  nombre String

  @@index([fecha])
}

/// Horario de atención de un local, un renglón por día de la semana (0=domingo
/// … 6=sábado). Define los límites del diagrama de Gantt semanal.
model HorarioLocal {
  id         String  @id @default(cuid())
  local      Local   @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId    String
  diaSemana  Int
  cerrado    Boolean @default(false)
  abre       String? // "09:00"
  cierra     String? // "23:00"

  @@unique([localId, diaSemana])
}

/// Puesto del empleado dentro de un local (mozo, cocinero, cajero...). Se
/// arma a mano por local: no hay una lista fija de puestos posibles.
model Categoria {
  id        String     @id @default(cuid())
  local     Local      @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId   String
  nombre    String
  createdAt DateTime   @default(now())
  empleados Empleado[]

  @@unique([localId, nombre])
}

model Empleado {
  id           String               @id @default(cuid())
  usuario      String               @unique
  nombre       String
  /// Sólo se usa para mandarle las alertas a admins y encargados.
  email        String?

  /// "scrypt:saltHex:hashHex". Null si todavía no se creó una contraseña
  /// (puede fichar sólo con passkey hasta que la registre).
  passwordHash String?

  /// Para liquidar sueldos: null hasta que el admin lo carga (individual o en
  /// masa). Un solo valor por empleado, vale en cualquier sucursal donde fiche.
  precioHora   Float?

  categoria    Categoria?           @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  categoriaId  String?

  /// Id de usuario en Fudo (por sucursal, cada Fudo es una cuenta separada),
  /// para atribuirle sus ventas como mozo sin depender de que el nombre
  /// coincida. Elegido a mano por el admin, no se re-adivina después.
  fudoUsuarioId String?
  /// Id de "Caja" en Fudo: en la cuenta de Fudo del negocio, cada caja es una
  /// persona (no un canal fijo), así que es la fuente correcta del efectivo
  /// esperado en el arqueo — no todos los mozos tienen caja propia, ni todas
  /// las cajas son mozos.
  fudoCajaId    String?

  /// Vector de 128 floats del rostro (Float32Array serializado). NO es una
  /// foto: es una huella matemática de la que no se puede reconstruir la cara.
  rostroDescriptor Bytes?
  /// Foto de referencia del alta, para que el encargado pueda auditar que la
  /// cara registrada es la de esta persona.
  rostroFoto       Bytes?
  rostroFotoTipo   String?
  rostroRegistradoEn DateTime?
  /// Cuándo aceptó que se procese su dato biométrico (Ley 25.326).
  consentimientoBiometrico DateTime?
  rol          Rol                  @default(EMPLEADO)
  activo       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  /// Sucursal por defecto: se usa al fichar si no hay turno que indique otra.
  local        Local                @relation("LocalPrincipal", fields: [localId], references: [id])
  localId      String
  asignaciones AsignacionLocal[]
  credenciales Credential[]
  invitaciones RegistroInvitacion[]
  turnos       Turno[]
  fichajes     Fichaje[]
  alertas      Alerta[]             @relation("AlertasDelEmpleado")
  alertasResueltas Alerta[]         @relation("AlertasResueltas")
  correcciones SolicitudCorreccion[] @relation("CorreccionesDelEmpleado")
  correccionesResueltas SolicitudCorreccion[] @relation("CorreccionesResueltas")
  ausencias    Ausencia[]           @relation("AusenciasDelEmpleado")
  ausenciasResueltas Ausencia[]     @relation("AusenciasResueltas")
  auditorias   Auditoria[]
}

/// Bitácora de cambios sensibles: quién tocó qué, cuándo y por qué.
/// Sólo se escribe, nunca se edita ni se borra.
model Auditoria {
  id        String   @id @default(cuid())
  /// "Fichaje", "Ausencia", "Empleado"…
  entidad   String
  entidadId String
  /// "CREAR", "MODIFICAR", "ELIMINAR", "APROBAR", "RECHAZAR"
  accion    String
  autor     Empleado @relation(fields: [autorId], references: [id])
  autorId   String
  antes     Json?
  despues   Json?
  motivo    String?
  createdAt DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([createdAt])
}

/// Pedido de un empleado para arreglar un fichaje mal cargado o faltante.
/// Nada se aplica hasta que un encargado lo aprueba.
model SolicitudCorreccion {
  id          String          @id @default(cuid())
  empleado    Empleado        @relation("CorreccionesDelEmpleado", fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId  String
  /// Fichaje afectado. Null cuando se pide agregar uno que falta.
  fichaje     Fichaje?        @relation(fields: [fichajeId], references: [id], onDelete: SetNull)
  fichajeId   String?
  tipo        TipoCorreccion
  /// Valores propuestos (para AGREGAR y MODIFICAR).
  tipoFichaje TipoFichaje?
  fechaHora   DateTime?
  motivo      String
  estado      EstadoSolicitud @default(PENDIENTE)
  resueltaPor Empleado?       @relation("CorreccionesResueltas", fields: [resueltaPorId], references: [id])
  resueltaPorId String?
  resueltaEn  DateTime?
  comentario  String?
  createdAt   DateTime        @default(now())

  @@index([estado, createdAt])
}

/// Vacaciones, francos, enfermedad y demás. Las aprobadas evitan que el
/// sistema marque a la persona como que no fichó.
model Ausencia {
  id            String          @id @default(cuid())
  empleado      Empleado        @relation("AusenciasDelEmpleado", fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId    String
  tipo          TipoAusencia
  desde         DateTime        @db.Date
  hasta         DateTime        @db.Date
  motivo        String?
  /// Foto del certificado, redimensionada en el navegador antes de subirla.
  certificado     Bytes?
  certificadoTipo String?
  estado        EstadoSolicitud @default(PENDIENTE)
  resueltaPor   Empleado?       @relation("AusenciasResueltas", fields: [resueltaPorId], references: [id])
  resueltaPorId String?
  resueltaEn    DateTime?
  comentario    String?
  createdAt     DateTime        @default(now())

  @@index([empleadoId, desde, hasta])
  @@index([estado])
}

/// Avisos generados a partir de los fichajes: no fichó, llegó tarde, se olvidó
/// de salir, jornada excesiva. El índice único hace que regenerarlas sea
/// idempotente: una sola alerta por empleado, día y tipo.
model Alerta {
  id            String     @id @default(cuid())
  empleado      Empleado   @relation("AlertasDelEmpleado", fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId    String
  local         Local      @relation(fields: [localId], references: [id])
  localId       String
  tipo          TipoAlerta
  /// Día al que se refiere la alerta.
  fecha         DateTime   @db.Date
  detalle       String
  resuelta      Boolean    @default(false)
  resueltaPor   Empleado?  @relation("AlertasResueltas", fields: [resueltaPorId], references: [id])
  resueltaPorId String?
  resueltaEn    DateTime?
  /// Cuándo se mandó por mail. Null = todavía no se notificó.
  notificadaEn  DateTime?
  createdAt     DateTime   @default(now())

  @@unique([empleadoId, fecha, tipo])
  @@index([resuelta, fecha])
}

/// Sucursales adicionales donde el empleado puede fichar (rotación).
model AsignacionLocal {
  id         String   @id @default(cuid())
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId String
  local      Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId    String
  createdAt  DateTime @default(now())

  @@unique([empleadoId, localId])
}

model Credential {
  id           String   @id @default(cuid())
  empleado     Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId   String
  credentialId String   @unique
  publicKey    Bytes
  counter      Int      @default(0)
  deviceName   String?
  createdAt    DateTime @default(now())
}

model RegistroInvitacion {
  id         String   @id @default(cuid())
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId String
  token      String   @unique
  usado      Boolean  @default(false)
  expiraEn   DateTime
  createdAt  DateTime @default(now())
}

model Turno {
  id         String   @id @default(cuid())
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId String
  local      Local    @relation(fields: [localId], references: [id])
  localId    String
  fecha      DateTime @db.Date
  /// Wall-clock para mostrar ("09:00"). El cálculo usa inicioAt/finAt.
  horaInicio String
  horaFin    String
  /// Instantes absolutos que resuelve el navegador al crear el turno, que ya
  /// conoce la zona horaria del local. Evita lógica de timezone en el servidor.
  /// ponytail: si algún día se cargan turnos desde otra zona horaria que el
  /// local, mover la conversión al servidor con la tz guardada en Local.
  inicioAt   DateTime
  finAt      DateTime
  createdAt  DateTime @default(now())

  @@index([empleadoId, fecha])
}

model Fichaje {
  id         String      @id @default(cuid())
  empleado   Empleado    @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId String
  local      Local       @relation(fields: [localId], references: [id])
  localId    String
  tipo       TipoFichaje
  timestamp  DateTime    @default(now())
  lat        Float?
  lng        Float?
  distanciaM Int?
  /// Cargado o editado por una corrección aprobada, no fichado en el momento.
  corregido  Boolean     @default(false)

  /// Resultado del control por cámara.
  rostro          VerificacionRostro @default(OMITIDA)
  /// Distancia euclídea contra el rostro registrado: más chica, más parecido.
  rostroDistancia Float?
  /// Foto del momento del fichaje. Sólo se guarda cuando la verificación no
  /// cerró, para que el encargado tenga evidencia del caso dudoso.
  rostroFoto      Bytes?
  rostroFotoTipo  String?

  /// Arqueo de caja, sólo cuando el empleado tiene una caja de Fudo
  /// vinculada. En la ENTRADA: cuánto había en la caja al abrir (fondo).
  /// En la SALIDA: fondo inicial + lo que Fudo registró vendido en efectivo
  /// entre la entrada y esta salida — lo que debería haber en la caja.
  fondoInicial     Float?
  efectivoEsperado Float?
  /// Lo que el empleado contó y cargó al fichar la salida.
  efectivoContado  Float?

  correcciones SolicitudCorreccion[]

  @@index([empleadoId, timestamp])
}
