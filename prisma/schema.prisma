generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migraciones, no la app: la pooled (PgBouncer) no soporta el estado de
  // sesión que Prisma Migrate necesita. Sólo existe en Vercel/Neon; en
  // Railway (túnel SSH local) no está seteada y Prisma cae de nuevo a `url`.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Rol {
  ADMIN
  ENCARGADO
  EMPLEADO
}

enum TipoFichaje {
  ENTRADA
  SALIDA
  DESCANSO_INICIO
  DESCANSO_FIN
}

enum TipoAlerta {
  NO_FICHO
  LLEGADA_TARDE
  SALIDA_OLVIDADA
  EXCESO_HORARIO
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TipoCorreccion {
  AGREGAR
  MODIFICAR
  ELIMINAR
}

enum TipoAusencia {
  VACACIONES
  ENFERMEDAD
  FRANCO
  LICENCIA
  FALTA
  OTRO
}

/// Un local dentro de un shopping no siente la lluvia como uno a la calle.
/// El modelo NO asume cuánto: usa esto para aprender la sensibilidad real de
/// cada tipo con los datos (ver `lib/forecast/clima.ts`).
enum TipoLocal {
  INDOOR_MALL
  OPEN_AIR
}

/// Sectores operativos para los que se calcula carga y dotación. Se mapean
/// desde las categorías de empleado que ya existen por local (`Categoria`).
enum Sector {
  COCINA
  SALON
  CAJA
  DESPACHO
  ENCARGADO
}

enum OrigenParametro {
  /// Valor por defecto, todavía sin evidencia propia del local.
  DEFECTO
  /// Calculado por el sistema a partir del histórico.
  APRENDIDO
  /// Fijado a mano por un administrador: gana sobre los otros dos.
  MANUAL
}

enum VerificacionRostro {
  /// La cara coincidió con la registrada.
  OK
  /// Se detectó una cara pero no es la registrada.
  NO_COINCIDE
  /// La cámara no encontró ninguna cara.
  SIN_ROSTRO
  /// El empleado todavía no registró su cara.
  NO_REGISTRADO
  /// Sin cámara o permiso denegado: se fichó sin verificar.
  OMITIDA
}

model Local {
  id          String @id @default(cuid())
  nombre      String
  lat         Float?
  lng         Float?
  radioMetros Int    @default(150)

  /// Si el descanso se resta de las horas trabajadas o se paga igual.
  descuentaDescanso Boolean @default(true)
  /// Minutos de gracia antes de marcar una llegada como tardanza.
  toleranciaMin     Int     @default(10)
  /// Horas semanales a partir de las cuales el excedente es hora extra.
  topeSemanalHoras  Float   @default(48)

  /// Exigir control de rostro por cámara al fichar.
  verificarRostro  Boolean @default(false)
  /// Distancia euclídea máxima para dar por buena la cara. El estándar del
  /// modelo es 0.6; más bajo es más estricto y rechaza más caras legítimas.
  /// Es un botón de calibración: cocina con vapor y gorro necesita más margen.
  rostroTolerancia Float   @default(0.55)

  /// Multiplicador de precio/hora en un día feriado (el calendario es único
  /// para todo el negocio, pero cada local puede pagarlo distinto).
  multiplicadorFeriado Float @default(2)

  /// Credenciales de la cuenta de Fudo DE ESTE LOCAL (cada sucursal es una
  /// cuenta separada). Null hasta que el admin las carga. Nunca se devuelven
  /// en una respuesta de API — sólo se usan server-side para sincronizar.
  fudoApiKey            String?
  fudoApiSecret         String?
  /// Certificado (PEM) y clave privada (PEM) de ARCA para facturar con el
  /// CUIT de este local. Mismo trato que las claves de Fudo: sólo server-side.
  /// El certificado vence (~2 años): el Dashboard avisa un mes antes.
  arcaCertificado       String?
  arcaClave             String?
  /// Punto de venta "Web Services" dado de alta en ARCA para Pulso. El CUIT
  /// que factura es `cuitCompras`: es el del local, el mismo de los remitos.
  arcaPuntoVenta        Int?
  /// false = homologación (pruebas, no emite facturas reales).
  arcaProduccion        Boolean   @default(false)
  /// Ticket de acceso de ARCA (~12 h). ARCA no da otro mientras éste siga
  /// vigente, así que se guarda y se reusa.
  arcaToken             String?
  arcaSign              String?
  arcaTicketVence       DateTime?
  /// Lo que la factura impresa tiene que decir del emisor y no está en otro
  /// lado: domicilio comercial, Ingresos Brutos, inicio de actividades. Una
  /// línea por renglón del ticket.
  arcaDatosTicket       String?
  /// Último sync exitoso del mapa de calor de demanda. Null si nunca corrió.
  demandaSincronizadaEn DateTime?
  /// Último sync exitoso del resumen diario que alimenta el dashboard.
  resumenSincronizadoEn DateTime?

  /// Expuesto o no al clima. Sin esto, el modelo no puede separar por qué un
  /// día de lluvia mueve a un local y al otro no.
  tipoLocal TipoLocal @default(OPEN_AIR)

  /// Cuántos días de historia usa el perfil de demanda de ESTE local. No es
  /// una preferencia: se elige por backtesting y da distinto en cada sucursal
  /// (45, 90 y 180 en la medición inicial). Un año nunca ganó: arrastra
  /// estacionalidad vieja que corre el nivel actual.
  ventanaForecastDias Int   @default(90)
  /// Lo que midió esa calibración: `{ wape, sesgoPct, diasEvaluados, corte,
  /// medidaEn, ranking }`. Se guarda porque calcularlo cuesta un backtest
  /// completo por ventana candidata: el cron semanal ya los corre para elegir
  /// la ventana, y sin esto la pantalla del modelo los repetía en cada carga
  /// para mostrar el mismo número.
  ventanaCalibracion  Json?

  /// Cómo figura ESTE local en los remitos del proveedor. El CUIT es la clave
  /// buena porque no cambia; la razón social se usa de respaldo cuando el
  /// remito no lo trae. Las Cañas es "CUMBRES Y PLACERES SAS (BIANCONERO
  /// GUAYMALLEN)", CUIT 30718808975. Sin esto cargado, los remitos de ese
  /// local quedan sin asignar en vez de caer en cualquier lado.
  cuitCompras        String?
  razonSocialCompras String?

  /// Comisiones que cobra cada medio de pago, sobre el monto liquidado.
  /// Son por local porque cada sucursal negocia sus propios contratos.
  /// Delivery es la que más pesa y menos se mira: 27% contra 2-4% del resto.
  comisionCredito   Float @default(0.04)
  comisionDebito    Float @default(0.02)
  comisionBilletera Float @default(0.02)
  comisionDelivery  Float @default(0.27)

  /// Cuenta corriente con la fábrica (Bianconero): lo que este local le debía
  /// antes de empezar a cargar remitos y pagos acá. El saldo actual es este
  /// número más los remitos —mercadería y servicio, el royalty es la misma
  /// empresa— con fecha posterior a `saldoInicialProveedorFecha`, menos los
  /// pagos cargados. Es por local porque cada sucursal factura con su propio
  /// CUIT (`cuitCompras`), así que cada una tiene su propia cuenta.
  saldoInicialProveedor      Float     @default(0)
  saldoInicialProveedorFecha DateTime? @db.Date

  empleados            Empleado[]           @relation("LocalPrincipal")
  asignados            AsignacionLocal[]
  turnos               Turno[]
  fichajes             Fichaje[]
  alertas              Alerta[]
  horarios             HorarioLocal[]
  categorias           Categoria[]
  demandas             DemandaHoraria[]
  resumenes            ResumenDiario[]
  stocks               StockDiario[]
  productosDiarios     ProductoDiario[]
  demandaSlots         DemandaSlot[]
  coeficientesSector   CoeficienteSector[]
  coeficientesCanal    CoeficienteCanal[]
  capacidades          CapacidadSector[]
  ajustesK             AjusteK[]
  climas               ClimaDia[]
  pronosticos          Pronostico[]
  compras              Compra[]
  costosFijos          CostoFijo[]
  pagosProveedor       PagoProveedor[]
  movimientosBancarios MovimientoBancario[]
  salones              Salon[]
  cocinas              Cocina[]
  categoriasVenta      CategoriaVenta[]
  productosVenta       ProductoVenta[]
  ingredientes         Ingrediente[]
  descuentos           DescuentoPlantilla[]
  mediosPago           MedioPago[]
  cajas                Caja[]
  ventas               Venta[]
  clientes             Cliente[]
  reservas             Reserva[]

  /// Propina sugerida que se imprime en la precuenta (10 = 10%). Null: no se imprime.
  propinaSugeridaPct Float?
}

/// Patrón histórico de demanda (ventas promedio por día de semana y hora),
/// cargado a mano desde un análisis de ventas del punto de venta. Se
/// superpone al Gantt semanal de turnos para ayudar a planificar dotación.
/// No se sincroniza en vivo con ningún POS.
model DemandaHoraria {
  id         String @id @default(cuid())
  local      Local  @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId    String
  diaSemana  Int
  hora       Int
  /// Promedio de ventas cerradas en esa franja, sobre las semanas de la
  /// muestra (no es un total acumulado).
  ventasProm Float

  @@unique([localId, diaSemana, hora])
}

/// Una fila por local y día calendario (hora argentina), armada desde Fudo.
/// El dashboard lee de acá y no de la API: un año de ventas son ~200 páginas
/// paginadas, imposible de esperar en pantalla; además las alertas necesitan
/// historia para comparar contra el promedio.
model ResumenDiario {
  id      String   @id @default(cuid())
  local   Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String
  fecha   DateTime @db.Date

  ventas      Float @default(0)
  /// Ventas cerradas del día (tickets).
  tickets     Int   @default(0)
  /// Suma de `people` de las ventas que lo traen (sólo salón; delivery y
  /// takeaway vienen sin el dato).
  personas    Int   @default(0)
  descuentos  Float @default(0)
  /// Facturación de las ventas anuladas (no está incluida en `ventas`).
  anulaciones Float @default(0)
  /// Gastos cargados en Fudo ese día (proveedores, servicios, retiros).
  gastos      Float @default(0)

  /// Costo de lo vendido, sumando el costo cargado en cada producto. Fudo
  /// deja el costo en null cuando no lo cargaron: `costoIncompleto` avisa que
  /// el margen que sale de acá es optimista, en vez de mostrarlo como cierto.
  costo           Float   @default(0)
  costoIncompleto Boolean @default(false)

  /// {"Efectivo": 12345, "Tarj. Débito": 6789, ...}
  porMedioPago      Json?
  /// {"EAT-IN": 12345, "TAKEAWAY": 6789, "DELIVERY": 0}
  porCanal          Json?
  /// {"CAFETERIA": 12345, "BEBIDAS Y JUGOS": 6789, ...}
  porCategoria      Json?
  /// Descuentos por caja — en esta cuenta de Fudo cada caja es una persona,
  /// así que esto responde "quién descontó": {"Antonella": 12345}
  descuentosPorCaja Json?
  /// [{"nombre": "PROMO LAMINATO", "cantidad": 12, "facturacion": 117600}]
  topProductos      Json?

  actualizadoEn DateTime @updatedAt

  @@unique([localId, fecha])
  @@index([localId, fecha])
}

/// Una fila por producto vendido, por local y por día. `ResumenDiario` guarda
/// sólo el top del día, que alcanza para "qué se vende" pero no para lo que
/// pide un análisis serio: los que MENOS salen, el mismo producto comparado
/// entre sucursales, o un rango de fechas cualquiera.
model ProductoDiario {
  id      String   @id @default(cuid())
  local   Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String
  fecha   DateTime @db.Date

  fudoProductoId String
  /// Desnormalizados: el histórico no puede depender de que el producto siga
  /// existiendo en Fudo, ni de que la categoría no se haya renombrado.
  producto       String
  categoria      String?

  cantidad    Float
  facturacion Float
  /// Costo de lo vendido según el costo cargado en Fudo (0 si no lo cargaron).
  costo       Float @default(0)

  @@unique([localId, fecha, fudoProductoId])
  @@index([localId, fecha])
  @@index([producto])
}

/// Foto diaria del stock de cada producto, para tener la serie que la API de
/// Fudo no guarda (devuelve el stock de ahora, no su historia).
///
/// Fudo descuenta el stock con cada venta, así que en un día sin recepciones
/// ni ajustes vale: stock_hoy = stock_ayer − vendido. `movimientoNoExplicado`
/// es lo que sobra de esa cuenta: mercadería que entró, un recuento a mano, o
/// una pérdida. Ese es el número accionable mientras nadie cargue las compras
/// en Fudo; el día que se carguen, la serie ya está y el desvío se vuelve un
/// "debería haber vs. hay" de verdad.
model StockDiario {
  id      String   @id @default(cuid())
  local   Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String
  fecha   DateTime @db.Date

  fudoProductoId String
  /// Desnormalizado a propósito: el reporte histórico no puede depender de
  /// que el producto siga existiendo (o llamándose igual) en Fudo.
  producto       String

  stock                 Float
  stockPrevio           Float?
  /// Unidades vendidas ese día, contadas desde los items de las ventas.
  vendido               Float  @default(0)
  movimientoNoExplicado Float?

  actualizadoEn DateTime @updatedAt

  @@unique([localId, fecha, fudoProductoId])
  @@index([localId, fecha])
}

// ─────────────────────────────────────────────────────────────────────────
// Módulo de pronóstico de demanda y dotación.
// La serie de 30 minutos es la base de todo: ni ResumenDiario (día) ni
// DemandaHoraria (promedio día-de-semana × hora, sin fecha) sirven para
// pronosticar, porque ninguno es una serie temporal real.
// ─────────────────────────────────────────────────────────────────────────

/// Una fila por local, día y franja de 30 minutos (slot 0 = 00:00-00:30 hora
/// argentina, slot 47 = 23:30-24:00). Guarda medidas crudas, no carga: la
/// carga depende de coeficientes editables y se calcula al leer, así cambiar
/// la matriz no obliga a re-sincronizar tres meses.
model DemandaSlot {
  id      String   @id @default(cuid())
  local   Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String
  fecha   DateTime @db.Date
  /// 0..47
  slot    Int

  tickets  Int   @default(0)
  /// Unidades vendidas (ítems), que pesan más que la plata para la carga.
  unidades Float @default(0)
  ventas   Float @default(0)
  /// Comensales declarados (sólo salón; delivery/takeaway vienen sin dato).
  personas Int   @default(0)

  /// {"EAT-IN": 12, "TAKEAWAY": 4, "DELIVERY": 2} — tickets por canal.
  porCanal     Json?
  /// {"cafeteria": 18, "panificados": 6} — unidades por categoría canónica.
  porCategoria Json?

  @@unique([localId, fecha, slot])
  @@index([localId, fecha])
}

/// Matriz categoría × sector: cuánta carga genera una unidad de esa categoría
/// en ese sector. Es el punto 9 del pedido y arranca con valores por defecto
/// razonables, marcados como DEFECTO para que se vea que todavía no se
/// aprendieron. Una fila con `localId` gana sobre la global (`localId` null).
model CoeficienteSector {
  id          String          @id @default(cuid())
  local       Local?          @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId     String?
  /// Categoría canónica (ver lib/forecast/categorias.ts), no el nombre crudo
  /// de Fudo: los locales escriben la misma categoría de cuatro formas.
  categoria   String
  sector      Sector
  coeficiente Float
  origen      OrigenParametro @default(DEFECTO)

  @@unique([localId, categoria, sector])
  @@index([categoria])
}

/// Carga que agrega un ticket por el solo hecho de existir, según su canal
/// (atender una mesa cuesta aunque el pedido sea chico; un delivery ocupa
/// despacho). Separado de la matriz de productos a propósito.
model CoeficienteCanal {
  id          String          @id @default(cuid())
  local       Local?          @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId     String?
  canal       String
  sector      Sector
  coeficiente Float
  origen      OrigenParametro @default(DEFECTO)

  @@unique([localId, canal, sector])
}

/// Cuánta carga por hora absorbe una persona en un sector. Es lo que traduce
/// carga en dotación, y hoy NO se puede aprender: hay 34 fichajes en total.
/// Por eso arranca en DEFECTO con la confianza en el piso, y el motor lo dice
/// en la salida en vez de presentar la dotación como si fuera medida.
model CapacidadSector {
  id      String @id @default(cuid())
  local   Local  @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String
  sector  Sector

  /// Puntos de SectorLoadScore por hora y por persona.
  capacidadPorEmpleado Float
  minPersonas          Int             @default(0)
  maxPersonas          Int             @default(10)
  origen               OrigenParametro @default(DEFECTO)
  /// 0..1. Sube a medida que hay fichajes reales contra los que calibrar.
  confianza            Float           @default(0.2)
  /// Cuántas observaciones (franja × día con dotación conocida) respaldan el
  /// valor. Con 0, la capacidad es un supuesto declarado, no un aprendizaje.
  observaciones        Int             @default(0)

  @@unique([localId, sector])
}

/// Ajuste manual de demanda (K_manual). Ámbito de menor a mayor precedencia:
/// local → día de semana → fecha puntual → franja. Por defecto no existe
/// ninguna fila y K_manual vale 1.
model AjusteK {
  id        String    @id @default(cuid())
  local     Local?    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId   String?
  /// 0..6 (domingo=0), null si no aplica.
  diaSemana Int?
  /// Fecha puntual (un evento, un corte de calle), null si no aplica.
  fecha     DateTime? @db.Date
  /// Franja de 30 min, null = todo el día.
  slot      Int?

  valor  Float
  motivo String?

  @@index([localId, fecha])
}

/// Sensibilidad al clima aprendida por tipo de local. Es el punto 19: en vez
/// de asumir "llueve → -18%", se mide contra el histórico y se guarda con su
/// confianza y con cuántos días la respaldan.
model SensibilidadClima {
  id          String          @id @default(cuid())
  tipoLocal   TipoLocal
  /// "LLUVIA", "FRIO", "CALOR"
  condicion   String
  /// Multiplicador medido sobre la demanda normal (1 = sin efecto).
  factor      Float
  confianza   Float           @default(0)
  /// Días de historia que respaldan el factor.
  dias        Int             @default(0)
  origen      OrigenParametro @default(DEFECTO)
  calculadoEn DateTime        @updatedAt

  @@unique([tipoLocal, condicion])
}

/// Clima por local y día. Histórico para aprender, pronóstico para proyectar.
/// Sin coordenadas cargadas en el local no hay clima, y el motor lo trata
/// como factor neutro en vez de inventarlo.
model ClimaDia {
  id      String   @id @default(cuid())
  local   Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String
  fecha   DateTime @db.Date

  tempMax      Float?
  tempMin      Float?
  lluviaMm     Float?
  vientoKmh    Float?
  /// true cuando viene del pronóstico y todavía no del histórico.
  esPronostico Boolean @default(false)

  @@unique([localId, fecha])
}

/// Forecast guardado. Nunca se borra: sin el histórico de pronósticos no se
/// puede saber si el modelo está mejorando (punto 16). Cuando llega el dato
/// real se completa `real*` y el error, en la misma fila.
model Pronostico {
  id      String   @id @default(cuid())
  local   Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String
  fecha   DateTime @db.Date
  /// null = fila del día completo; 0..47 = franja de 30 minutos.
  slot    Int?

  /// Cuándo se emitió: dos pronósticos de la misma fecha hechos en momentos
  /// distintos no son el mismo pronóstico.
  emitidoEn DateTime @default(now())

  demandaBase  Float
  kAuto        Float
  kManual      Float @default(1)
  demandaFinal Float
  /// {"K_calendar":1.18,"K_weather":1.06,...} para poder explicarlo.
  kDetalle     Json?

  ticketsPronosticados  Float
  unidadesPronosticadas Float
  ventasPronosticadas   Float
  /// Índice normalizado: 100 = demanda normal de ESE local en ESA franja.
  demandIndex           Float

  /// Intervalo de confianza sobre tickets.
  ticketsMin Float?
  ticketsMax Float?
  confianza  Float?

  /// {"COCINA": 3, "SALON": 2, ...}
  cargaPorSector    Json?
  dotacionPorSector Json?

  /// Se completan cuando llega el día.
  ticketsReales Float?
  ventasReales  Float?
  errorTickets  Float?

  @@unique([localId, fecha, slot, emitidoEn])
  @@index([localId, fecha])
}

/// Calendario nacional de feriados, único para todo el negocio (cada local
/// paga su multiplicador propio sobre estos días, ver `Local.multiplicadorFeriado`).
model Feriado {
  id     String   @id @default(cuid())
  fecha  DateTime @unique @db.Date
  nombre String

  @@index([fecha])
}

/// Horario de atención de un local, un renglón por día de la semana (0=domingo
/// … 6=sábado). Define los límites del diagrama de Gantt semanal.
model HorarioLocal {
  id        String  @id @default(cuid())
  local     Local   @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId   String
  diaSemana Int
  cerrado   Boolean @default(false)
  abre      String? // "09:00"
  cierra    String? // "23:00"

  @@unique([localId, diaSemana])
}

/// Puesto del empleado dentro de un local (mozo, cocinero, cajero...). Se
/// arma a mano por local: no hay una lista fija de puestos posibles.
model Categoria {
  id        String     @id @default(cuid())
  local     Local      @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId   String
  nombre    String
  createdAt DateTime   @default(now())
  empleados Empleado[]

  @@unique([localId, nombre])
}

model Empleado {
  id      String  @id @default(cuid())
  usuario String  @unique
  nombre  String
  /// Sólo se usa para mandarle las alertas a admins y encargados.
  email   String?

  /// "scrypt:saltHex:hashHex". Null si todavía no se creó una contraseña
  /// (puede fichar sólo con passkey hasta que la registre).
  passwordHash String?

  /// Para liquidar sueldos: null hasta que el admin lo carga (individual o en
  /// masa). Un solo valor por empleado, vale en cualquier sucursal donde fiche.
  precioHora Float?

  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  categoriaId String?

  /// Id de usuario en Fudo (por sucursal, cada Fudo es una cuenta separada),
  /// para atribuirle sus ventas como mozo sin depender de que el nombre
  /// coincida. Elegido a mano por el admin, no se re-adivina después.
  fudoUsuarioId String?
  /// Id de "Caja" en Fudo: en la cuenta de Fudo del negocio, cada caja es una
  /// persona (no un canal fijo), así que es la fuente correcta del efectivo
  /// esperado en el arqueo — no todos los mozos tienen caja propia, ni todas
  /// las cajas son mozos.
  fudoCajaId    String?

  /// Vector de 128 floats del rostro (Float32Array serializado). NO es una
  /// foto: es una huella matemática de la que no se puede reconstruir la cara.
  rostroDescriptor         Bytes?
  /// Foto de referencia del alta, para que el encargado pueda auditar que la
  /// cara registrada es la de esta persona.
  rostroFoto               Bytes?
  rostroFotoTipo           String?
  rostroRegistradoEn       DateTime?
  /// Cuándo aceptó que se procese su dato biométrico (Ley 25.326).
  consentimientoBiometrico DateTime?
  rol                      Rol                   @default(EMPLEADO)
  activo                   Boolean               @default(true)
  /// Se creó la cuenta sola desde la pantalla de ingreso y espera que un
  /// admin la active. Null para todo el resto: un desactivado no está
  /// "pendiente", es alguien que ya no trabaja.
  pendienteDesde           DateTime?
  /// Rol de ventas (permisos del módulo de ventas), configurable como en Fudo.
  rolVenta                 RolVenta?             @relation(fields: [rolVentaId], references: [id], onDelete: SetNull)
  rolVentaId               String?
  cajasAbiertas            Caja[]                @relation("CajasAbiertas")
  cajasCerradas            Caja[]                @relation("CajasCerradas")
  movimientosCaja          MovimientoCaja[]
  ventasComoMozo           Venta[]               @relation("VentasComoMozo")
  ventasAbiertas           Venta[]               @relation("VentasAbiertas")
  ventasCerradas           Venta[]               @relation("VentasCerradas")
  ventasAnuladas           Venta[]               @relation("VentasAnuladas")
  itemsCargados            ItemVenta[]           @relation("ItemsCargados")
  itemsAnulados            ItemVenta[]           @relation("ItemsAnulados")
  pagosCobrados            PagoVenta[]           @relation("PagosCobrados")
  createdAt                DateTime              @default(now())
  /// Sucursal por defecto: se usa al fichar si no hay turno que indique otra.
  local                    Local                 @relation("LocalPrincipal", fields: [localId], references: [id])
  localId                  String
  asignaciones             AsignacionLocal[]
  credenciales             Credential[]
  invitaciones             RegistroInvitacion[]
  turnos                   Turno[]
  fichajes                 Fichaje[]
  alertas                  Alerta[]              @relation("AlertasDelEmpleado")
  alertasResueltas         Alerta[]              @relation("AlertasResueltas")
  correcciones             SolicitudCorreccion[] @relation("CorreccionesDelEmpleado")
  correccionesResueltas    SolicitudCorreccion[] @relation("CorreccionesResueltas")
  ausencias                Ausencia[]            @relation("AusenciasDelEmpleado")
  ausenciasResueltas       Ausencia[]            @relation("AusenciasResueltas")
  auditorias               Auditoria[]
}

/// Bitácora de cambios sensibles: quién tocó qué, cuándo y por qué.
/// Sólo se escribe, nunca se edita ni se borra.
model Auditoria {
  id        String   @id @default(cuid())
  /// "Fichaje", "Ausencia", "Empleado"…
  entidad   String
  entidadId String
  /// "CREAR", "MODIFICAR", "ELIMINAR", "APROBAR", "RECHAZAR"
  accion    String
  autor     Empleado @relation(fields: [autorId], references: [id])
  autorId   String
  antes     Json?
  despues   Json?
  motivo    String?
  createdAt DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([createdAt])
}

/// Pedido de un empleado para arreglar un fichaje mal cargado o faltante.
/// Nada se aplica hasta que un encargado lo aprueba.
model SolicitudCorreccion {
  id            String          @id @default(cuid())
  empleado      Empleado        @relation("CorreccionesDelEmpleado", fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId    String
  /// Fichaje afectado. Null cuando se pide agregar uno que falta.
  fichaje       Fichaje?        @relation(fields: [fichajeId], references: [id], onDelete: SetNull)
  fichajeId     String?
  tipo          TipoCorreccion
  /// Valores propuestos (para AGREGAR y MODIFICAR).
  tipoFichaje   TipoFichaje?
  fechaHora     DateTime?
  motivo        String
  estado        EstadoSolicitud @default(PENDIENTE)
  resueltaPor   Empleado?       @relation("CorreccionesResueltas", fields: [resueltaPorId], references: [id])
  resueltaPorId String?
  resueltaEn    DateTime?
  comentario    String?
  createdAt     DateTime        @default(now())

  @@index([estado, createdAt])
}

/// Vacaciones, francos, enfermedad y demás. Las aprobadas evitan que el
/// sistema marque a la persona como que no fichó.
model Ausencia {
  id              String          @id @default(cuid())
  empleado        Empleado        @relation("AusenciasDelEmpleado", fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId      String
  tipo            TipoAusencia
  desde           DateTime        @db.Date
  hasta           DateTime        @db.Date
  motivo          String?
  /// Foto del certificado, redimensionada en el navegador antes de subirla.
  certificado     Bytes?
  certificadoTipo String?
  estado          EstadoSolicitud @default(PENDIENTE)
  resueltaPor     Empleado?       @relation("AusenciasResueltas", fields: [resueltaPorId], references: [id])
  resueltaPorId   String?
  resueltaEn      DateTime?
  comentario      String?
  createdAt       DateTime        @default(now())

  @@index([empleadoId, desde, hasta])
  @@index([estado])
}

/// Avisos generados a partir de los fichajes: no fichó, llegó tarde, se olvidó
/// de salir, jornada excesiva. El índice único hace que regenerarlas sea
/// idempotente: una sola alerta por empleado, día y tipo.
model Alerta {
  id            String     @id @default(cuid())
  empleado      Empleado   @relation("AlertasDelEmpleado", fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId    String
  local         Local      @relation(fields: [localId], references: [id])
  localId       String
  tipo          TipoAlerta
  /// Día al que se refiere la alerta.
  fecha         DateTime   @db.Date
  detalle       String
  resuelta      Boolean    @default(false)
  resueltaPor   Empleado?  @relation("AlertasResueltas", fields: [resueltaPorId], references: [id])
  resueltaPorId String?
  resueltaEn    DateTime?
  /// Cuándo se mandó por mail. Null = todavía no se notificó.
  notificadaEn  DateTime?
  createdAt     DateTime   @default(now())

  @@unique([empleadoId, fecha, tipo])
  @@index([resuelta, fecha])
}

/// Sucursales adicionales donde el empleado puede fichar (rotación).
model AsignacionLocal {
  id         String   @id @default(cuid())
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId String
  local      Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId    String
  createdAt  DateTime @default(now())

  @@unique([empleadoId, localId])
}

model Credential {
  id           String   @id @default(cuid())
  empleado     Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId   String
  credentialId String   @unique
  publicKey    Bytes
  counter      Int      @default(0)
  deviceName   String?
  createdAt    DateTime @default(now())
}

model RegistroInvitacion {
  id         String   @id @default(cuid())
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId String
  token      String   @unique
  usado      Boolean  @default(false)
  expiraEn   DateTime
  createdAt  DateTime @default(now())
}

model Turno {
  id         String   @id @default(cuid())
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId String
  local      Local    @relation(fields: [localId], references: [id])
  localId    String
  fecha      DateTime @db.Date
  /// Wall-clock para mostrar ("09:00"). El cálculo usa inicioAt/finAt.
  horaInicio String
  horaFin    String
  /// Instantes absolutos que resuelve el navegador al crear el turno, que ya
  /// conoce la zona horaria del local. Evita lógica de timezone en el servidor.
  /// ponytail: si algún día se cargan turnos desde otra zona horaria que el
  /// local, mover la conversión al servidor con la tz guardada en Local.
  inicioAt   DateTime
  finAt      DateTime
  createdAt  DateTime @default(now())

  @@index([empleadoId, fecha])
}

model Fichaje {
  id         String      @id @default(cuid())
  empleado   Empleado    @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId String
  local      Local       @relation(fields: [localId], references: [id])
  localId    String
  tipo       TipoFichaje
  timestamp  DateTime    @default(now())
  lat        Float?
  lng        Float?
  distanciaM Int?
  /// Cargado o editado por una corrección aprobada, no fichado en el momento.
  corregido  Boolean     @default(false)

  /// Resultado del control por cámara.
  rostro          VerificacionRostro @default(OMITIDA)
  /// Distancia euclídea contra el rostro registrado: más chica, más parecido.
  rostroDistancia Float?
  /// Foto del momento del fichaje. Sólo se guarda cuando la verificación no
  /// cerró, para que el encargado tenga evidencia del caso dudoso.
  rostroFoto      Bytes?
  rostroFotoTipo  String?

  /// Arqueo de caja, sólo cuando el empleado tiene una caja de Fudo
  /// vinculada. En la ENTRADA: cuánto había en la caja al abrir (fondo).
  /// En la SALIDA: fondo inicial + lo que Fudo registró vendido en efectivo
  /// entre la entrada y esta salida — lo que debería haber en la caja.
  fondoInicial     Float?
  efectivoEsperado Float?
  /// Lo que el empleado contó y cargó al fichar la salida.
  efectivoContado  Float?

  correcciones SolicitudCorreccion[]

  @@index([empleadoId, timestamp])
}

/// Un remito de compra del proveedor, tal como llegó.
///
/// Se guarda el texto extraído del PDF además del detalle parseado: si algún
/// día el proveedor cambia el formato y el parser se equivoca, se puede volver
/// a leer sin pedirle los PDF de nuevo. Los remitos que no se pudieron asignar
/// a un local quedan con `localId` en null y aparecen en la bandeja, nunca se
/// adivina de quién son.
model Compra {
  id      String  @id @default(cuid())
  local   Local?  @relation(fields: [localId], references: [id], onDelete: SetNull)
  localId String?

  /// Punto de venta y número: "16-5004". Con el CUIT del cliente identifican
  /// al remito de forma única y evitan cargar dos veces el mismo mail.
  numero        String
  puntoVenta    Int
  /// Día del remito, `@db.Date` como el resto del sistema.
  fecha         DateTime @db.Date
  proveedor     String
  /// Razón social del cliente en el remito, que es lo que asigna el local.
  cliente       String
  cuit          String?
  observaciones String?

  /// Suma del detalle, sin el ajuste.
  sumaLineas Float
  /// El campo que el remito rotula "Desc. aplicado (%)" y que en realidad
  /// SUMA: el subtotal es la suma de líneas × (1 + ajustePct/100). Se guarda
  /// como viene y el signo se decide al leerlo.
  ajustePct  Float?
  subtotal   Float
  total      Float

  /// `MERCADERIA` o `SERVICIO`: el remito de "USO DE MARCA" es un royalty y
  /// no puede entrar al food cost junto con el café.
  tipo TipoCompra @default(MERCADERIA)

  /// IVA discriminado en la Factura A: crédito fiscal. Null en los remitos
  /// ("Presupuesto X"), que no dan crédito. Con esto el Resultado toma el
  /// neto real (subtotal − IVA) y no lo estima con la alícuota general, que
  /// erra con los productos al 10,5%.
  ivaCredito Float?

  /// Un remito al que después le llegó su factura: la factura es la deuda
  /// real (decisión del 12/11/2026) y el remito deja de sumar en todos lados.
  /// No se borra, para no perder los códigos de producto ni el rastro. Si la
  /// factura se borra, el remito vuelve a contar solo.
  reemplazadaPor   Compra?  @relation("ReemplazoPorFactura", fields: [reemplazadaPorId], references: [id], onDelete: SetNull)
  reemplazadaPorId String?
  reemplaza        Compra[] @relation("ReemplazoPorFactura")

  /// Qué dijo la verificación contra los totales del propio remito. Un remito
  /// con problemas se guarda igual pero no se suma a los costos hasta que
  /// alguien lo mire.
  verificado Boolean  @default(false)
  problemas  String[]

  /// De dónde salió: el remitente y el asunto del mail, para poder rastrear.
  origen     String?
  textoPlano String?

  creadoEn DateTime     @default(now())
  items    CompraItem[]

  @@unique([puntoVenta, numero, cuit])
  @@index([localId, fecha])
}

enum TipoCompra {
  MERCADERIA
  SERVICIO
}

/// Una línea del remito.
model CompraItem {
  id       String @id @default(cuid())
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)
  compraId String

  /// Código del proveedor. Es la clave estable entre remitos: el mismo café
  /// aparece como "X KG" y "x kg" con distinto precio en la misma semana.
  codigo         String
  detalle        String
  /// La cantidad impresa, con dos decimales.
  cantidad       Float
  /// La que sale de dividir total por unitario. El proveedor imprime dos
  /// decimales y factura con tres.
  cantidadExacta Float
  unidad         String
  precioUnitario Float
  /// Lo que dice la línea, que es lo que se cobra.
  total          Float
  /// El total con el ajuste del remito prorrateado: lo que realmente se paga.
  totalConAjuste Float

  @@index([compraId])
  @@index([codigo])
}

/// Los tres sectores del negocio, más el limbo de las promociones.
///
/// `PROMOCION` no es un sector: es la marca de que esa plata todavía no se
/// pudo atribuir. Fudo guarda las promos como un producto único ("PROMO
/// CLÁSICA", $11,4M en agosto) sin decir qué llevan adentro, y son el 31% de
/// la facturación. Repartirlas a ojo sería inventar un tercio de la venta.
enum SectorNegocio {
  HELADOS
  CAFETERIA
  CHOCOLATERIA
  PROMOCION
}

/// Excepción de clasificación cargada a mano.
///
/// Las reglas viven en `lib/compras/sectores.ts` y resuelven el 99% de la
/// facturación: son el vocabulario del negocio, se testean y se revisan en un
/// diff. Acá va sólo lo que las reglas no pueden saber — "COPA DEL MUNDO" es
/// un helado y no hay forma de deducirlo del nombre.
model SectorProducto {
  id       String        @id @default(cuid())
  /// Nombre normalizado (sin acentos, mayúsculas, espacios colapsados): el
  /// mismo producto viene escrito distinto en cada sucursal.
  producto String        @unique
  sector   SectorNegocio
  creadoEn DateTime      @default(now())

  @@index([sector])
}

/// Un costo fijo mensual de un local, cargado a mano.
///
/// Alquiler, servicios, seguros e impuestos no están en Fudo ni en los
/// remitos, y sin ellos el resultado se queda en margen de contribución. Son
/// pocos números por mes y no se pueden deducir de ningún lado: se cargan.
///
/// Va por concepto y no en columnas fijas para que agregar contador o
/// mantenimiento no necesite una migración.
model CostoFijo {
  id       String  @id @default(cuid())
  local    Local   @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId  String
  /// 2026-08. Mensual: es la unidad en la que se pagan estas cosas.
  mes      String
  concepto String
  monto    Float
  nota     String?

  @@unique([localId, mes, concepto])
  @@index([localId, mes])
}

enum CategoriaBancaria {
  /// Tarjeta de crédito, débito, prepaga, Mercado Pago, QR, posnet: todo lo
  /// que Nave liquida como "PAGO CON TARJETA" en el extracto.
  TARJETA
  /// Transferencias recibidas: lo que Nave liquida como "PAGO CON
  /// TRANSFERENCIA", y las transferencias directas de otros orígenes.
  TRANSFERENCIA
  /// Impuestos y comisiones que cobra el banco (Ley 25413, IVA, percepciones,
  /// comisión de mantenimiento): nunca es venta, así que queda afuera de la
  /// conciliación pero se muestra aparte porque también es plata real.
  IMPUESTO_COMISION
  /// Pagos a proveedores, débitos automáticos, movimientos de caja: todo lo
  /// que no es ni cobro de venta ni costo bancario.
  OTRO
}

/// Un renglón del extracto bancario, importado desde el CSV que exporta el
/// banco. Sirve para conciliar lo que Fudo dice que se cobró por tarjeta y
/// transferencia contra lo que de verdad entró a la cuenta: Fudo registra la
/// venta el día que se hizo, el banco la acredita uno o más días después y ya
/// neta de la comisión de Nave, así que los dos números nunca van a calzar
/// exacto — la conciliación es por período, no remito por remito.
model MovimientoBancario {
  id      String @id @default(cuid())
  local   Local  @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String

  fecha       DateTime          @db.Date
  descripcion String
  /// La columna "Origen" del extracto: número de operación, quién transfirió.
  referencia  String?
  categoria   CategoriaBancaria

  credito Float  @default(0)
  debito  Float  @default(0)
  /// Saldo acumulado que informa el banco después de este movimiento. Es la
  /// clave que evita cargar el mismo extracto dos veces: en un extracto real
  /// es prácticamente irrepetible fila a fila, a diferencia de la fecha o el
  /// monto solos, que sí se repiten.
  saldo   Float?

  creadoEn DateTime @default(now())

  @@unique([localId, fecha, saldo])
  @@index([localId, fecha])
}

/// Un pago a la fábrica, cargado a mano. Junto con los remitos (`Compra`,
/// que ya se cargan solos por mail) y el saldo inicial del local, compone la
/// cuenta corriente: no se guarda un saldo, se recalcula siempre de estas
/// tres fuentes para que nunca quede desincronizado de los remitos reales.
/// Cuántos gramos de helado lleva cada formato de venta (bocha, pote…). Hay
/// fila sólo para lo que el dueño cambió: el resto usa el valor de fábrica de
/// `REGLAS_HELADO` en `lib/compras/consumoHelado.ts`. Es de toda la cadena:
/// una bocha pesa lo mismo en todas las sucursales.
model EquivalenciaHelado {
  /// El `id` de la regla: "bocha-1", "cuarto", "kilo"…
  formato       String   @id
  gramos        Float
  actualizadoEn DateTime @updatedAt
}

model PagoProveedor {
  id      String @id @default(cuid())
  local   Local  @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String

  fecha DateTime @db.Date
  monto Float
  /// Transferencia, efectivo, cheque... texto libre, no hay un medio fijo.
  medio String?
  nota  String?

  creadoEn DateTime @default(now())

  @@index([localId, fecha])
}

// ─── Ventas (beta) ──────────────────────────────────────────────────────────
// El modelo copia el de Fudo (salones, mesas, ventas, ítems, pagos, cajas,
// roles con permisos) para que la carta y el plano se importen tal cual.
// Ticket NO fiscal: nada de esto emite comprobantes de AFIP.

enum TipoVenta {
  MESA
  MOSTRADOR
  DELIVERY // reservado para PedidosYa / Uber Eats, etapa siguiente
}

enum EstadoVenta {
  EN_CURSO
  CERRADA
  ANULADA
}

/// Los motivos de anulación de un ítem, los mismos que usa Fudo.
enum MotivoAnulacionItem {
  PEDIDO_DEL_CLIENTE
  DEMORA_EN_COCINA
  ERROR
  CLIENTE_INSATISFECHO
  CAMBIO_DE_PRODUCTO
  SIN_STOCK
  PRUEBA
  OTRO
}

enum TipoMedioPago {
  EFECTIVO
  DEBITO
  CREDITO
  TRANSFERENCIA
  QR
  CUENTA_CORRIENTE
  APP_DELIVERY
  OTRO
}

enum FormaMesa {
  CUADRADA
  REDONDA
}

enum TamanoMesa {
  CHICA
  GRANDE
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
}

/// Rol de ventas configurable, como en Fudo: un nombre, si es mozo, y la
/// lista de permisos con los mismos códigos de Fudo ("cancel_additions",
/// "close_sales"…). Es aparte de Empleado.rol, que sigue mandando sobre qué
/// pantallas de Pulso ve cada uno.
model RolVenta {
  id        String     @id @default(cuid())
  nombre    String     @unique
  esMozo    Boolean    @default(false)
  permisos  String[]
  /// Id del rol en Fudo de donde se importó, para no duplicarlo al re-sincronizar.
  fudoId    Int?       @unique
  empleados Empleado[]
  createdAt DateTime   @default(now())
}

/// Un salón del local: "Salón", "Terraza".
model Salon {
  id      String @id @default(cuid())
  local   Local  @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String
  nombre  String
  orden   Int    @default(0)
  fudoId  Int?
  mesas   Mesa[]

  @@unique([localId, fudoId])
}

/// Una mesa en la grilla del plano (fila y columna, como en Fudo).
model Mesa {
  id       String     @id @default(cuid())
  salon    Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  salonId  String
  numero   Int
  fila     Int
  columna  Int
  forma    FormaMesa  @default(CUADRADA)
  tamano   TamanoMesa @default(CHICA)
  activa   Boolean    @default(true)
  fudoId   Int?
  ventas   Venta[]
  reservas Reserva[]

  @@unique([salonId, numero])
}

/// Adónde va la comanda impresa: Barra, Cocina, Cafetería, Heladería.
model Cocina {
  id         String           @id @default(cuid())
  local      Local            @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId    String
  nombre     String
  fudoId     Int?
  categorias CategoriaVenta[]
  productos  ProductoVenta[]
  items      ItemVenta[]

  @@unique([localId, fudoId])
}

model CategoriaVenta {
  id        String           @id @default(cuid())
  local     Local            @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId   String
  nombre    String
  orden     Int              @default(0)
  /// Subcategorías, como en Fudo ("Cafetería" › "Cafés fríos").
  padre     CategoriaVenta?  @relation("SubcategoriasVenta", fields: [padreId], references: [id], onDelete: SetNull)
  padreId   String?
  hijas     CategoriaVenta[] @relation("SubcategoriasVenta")
  /// La cocina por defecto de sus productos.
  cocina    Cocina?          @relation(fields: [cocinaId], references: [id], onDelete: SetNull)
  cocinaId  String?
  fudoId    Int?
  productos ProductoVenta[]

  @@unique([localId, fudoId])
}

model ProductoVenta {
  id          String         @id @default(cuid())
  local       Local          @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId     String
  categoria   CategoriaVenta @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  categoriaId String
  nombre      String
  codigo      String?
  /// Precio de carta, con IVA.
  precio      Float
  activo      Boolean        @default(true)
  favorito    Boolean        @default(false)
  orden       Int            @default(0)
  /// Si es otra que la de su categoría.
  cocina      Cocina?        @relation(fields: [cocinaId], references: [id], onDelete: SetNull)
  cocinaId    String?
  fudoId      Int?
  /// Cuándo se editó en Pulso. Si tiene fecha, sincronizar con Fudo ya no lo pisa.
  editadoEn   DateTime?
  items       ItemVenta[]
  receta      RecetaItem[]

  @@unique([localId, fudoId])
  @@index([localId, activo])
}

model MedioPago {
  id      String        @id @default(cuid())
  local   Local         @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId String
  nombre  String
  tipo    TipoMedioPago
  activo  Boolean       @default(true)
  orden   Int           @default(0)
  fudoId  Int?
  pagos   PagoVenta[]

  @@unique([localId, fudoId])
}

/// Una caja abierta: de la apertura con su fondo al cierre con lo contado.
/// Las ventas que se cobran mientras está abierta quedan en ella.
model Caja {
  id              String           @id @default(cuid())
  local           Local            @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId         String
  /// "Caja principal", "Caja heladería": un local puede tener varias.
  nombre          String           @default("Caja principal")
  abiertaPor      Empleado         @relation("CajasAbiertas", fields: [abiertaPorId], references: [id])
  abiertaPorId    String
  abiertaEn       DateTime         @default(now())
  fondoInicial    Float            @default(0)
  cerradaPor      Empleado?        @relation("CajasCerradas", fields: [cerradaPorId], references: [id])
  cerradaPorId    String?
  cerradaEn       DateTime?
  /// Lo que se contó al cerrar; lo esperado se calcula de los pagos en efectivo.
  efectivoContado Float?
  comentario      String?
  ventas          Venta[]
  pagos           PagoVenta[]
  movimientos     MovimientoCaja[]

  @@index([localId, cerradaEn])
}

/// Plata que entra o sale de la caja sin ser una venta: un retiro, un pago al
/// proveedor de hielo.
model MovimientoCaja {
  id         String             @id @default(cuid())
  caja       Caja               @relation(fields: [cajaId], references: [id], onDelete: Cascade)
  cajaId     String
  tipo       TipoMovimientoCaja
  monto      Float
  motivo     String
  empleado   Empleado           @relation(fields: [empleadoId], references: [id])
  empleadoId String
  createdAt  DateTime           @default(now())
}

/// Una venta: una mesa abierta, un pedido de mostrador.
///
/// Una mesa no puede tener dos ventas en curso: lo garantiza un índice único
/// parcial que va en la migración SQL (Prisma no los declara):
///   CREATE UNIQUE INDEX ... ON "Venta"("mesaId") WHERE estado = 'EN_CURSO';
model Venta {
  id              String              @id @default(cuid())
  local           Local               @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId         String
  /// Número correlativo por local, el que se lee en voz alta: "la 1042".
  numero          Int
  tipo            TipoVenta
  estado          EstadoVenta         @default(EN_CURSO)
  mesa            Mesa?               @relation(fields: [mesaId], references: [id], onDelete: SetNull)
  mesaId          String?
  mozo            Empleado?           @relation("VentasComoMozo", fields: [mozoId], references: [id])
  mozoId          String?
  abiertaPor      Empleado            @relation("VentasAbiertas", fields: [abiertaPorId], references: [id])
  abiertaPorId    String
  abiertaEn       DateTime            @default(now())
  comensales      Int?
  /// Nombre para llamar en mostrador ("Juan") o el cliente de la mesa.
  cliente         String?
  /// El cliente de la libreta, si se eligió uno: habilita la cuenta corriente.
  clienteRef      Cliente?            @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  clienteId       String?
  comentario      String?
  /// Descuento sobre el total de la venta: porcentaje o monto fijo.
  descuentoPct    Float?
  descuentoMonto  Float               @default(0)
  descuentoMotivo String?
  /// Se fija al cerrar; mientras está en curso se calcula de los ítems.
  total           Float?
  caja            Caja?               @relation(fields: [cajaId], references: [id], onDelete: SetNull)
  cajaId          String?
  cerradaPor      Empleado?           @relation("VentasCerradas", fields: [cerradaPorId], references: [id])
  cerradaPorId    String?
  cerradaEn       DateTime?
  anuladaPor      Empleado?           @relation("VentasAnuladas", fields: [anuladaPorId], references: [id])
  anuladaPorId    String?
  anuladaEn       DateTime?
  motivoAnulacion String?
  items           ItemVenta[]
  pagos           PagoVenta[]
  comprobantes    ComprobanteFiscal[]

  @@unique([localId, numero])
  @@index([localId, estado])
  @@index([localId, abiertaEn])
}

/// Un renglón del pedido. Nombre y precio se copian del producto al cargarlo:
/// si mañana cambia la carta, la venta de hoy no cambia.
model ItemVenta {
  id                  String               @id @default(cuid())
  venta               Venta                @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  ventaId             String
  producto            ProductoVenta?       @relation(fields: [productoId], references: [id], onDelete: SetNull)
  productoId          String?
  nombre              String
  precio              Float
  cantidad            Float                @default(1)
  /// "Sin azúcar", "bien caliente": sale impreso en la comanda.
  comentario          String?
  cocina              Cocina?              @relation(fields: [cocinaId], references: [id], onDelete: SetNull)
  cocinaId            String?
  creadoPor           Empleado             @relation("ItemsCargados", fields: [creadoPorId], references: [id])
  creadoPorId         String
  createdAt           DateTime             @default(now())
  /// Cuándo se imprimió la comanda. Null = cargado pero todavía no enviado:
  /// se puede borrar sin permiso; después, anularlo pide motivo y permiso.
  enviadoEn           DateTime?
  /// Dónde está en la cocina, una vez enviado: lo mueve el monitor de cocina.
  estadoCocina        EstadoCocina         @default(PENDIENTE)
  listoEn             DateTime?
  /// Descuento sobre este renglón: porcentaje (con `descuentoMonto` como
  /// tope, si es > 0) o, sin porcentaje, un monto fijo. `descuentoNombre` es
  /// el descuento de la lista que se usó, o "Libre".
  descuentoPct        Float?
  descuentoMonto      Float                @default(0)
  descuentoNombre     String?
  anulado             Boolean              @default(false)
  motivoAnulacion     MotivoAnulacionItem?
  comentarioAnulacion String?
  anuladoPor          Empleado?            @relation("ItemsAnulados", fields: [anuladoPorId], references: [id])
  anuladoPorId        String?
  anuladoEn           DateTime?

  @@index([ventaId])
}

/// Un cobro. Una venta se puede pagar con varios (mitad efectivo, mitad débito).
model PagoVenta {
  id           String    @id @default(cuid())
  venta        Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  ventaId      String
  medioPago    MedioPago @relation(fields: [medioPagoId], references: [id])
  medioPagoId  String
  monto        Float
  /// La propina va aparte del monto: no es venta, es del personal.
  propina      Float     @default(0)
  caja         Caja?     @relation(fields: [cajaId], references: [id], onDelete: SetNull)
  cajaId       String?
  cobradoPor   Empleado  @relation("PagosCobrados", fields: [cobradoPorId], references: [id])
  cobradoPorId String
  createdAt    DateTime  @default(now())
  anulado      Boolean   @default(false)

  @@index([ventaId])
}

/// Factura o nota de crédito de ARCA de una venta. Se crea antes de pedir el
/// CAE: si ARCA no responde queda sin CAE (pendiente) y se reintenta, así la
/// venta se cierra igual y nadie espera en el mostrador.
model ComprobanteFiscal {
  id                   String              @id @default(cuid())
  venta                Venta               @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  ventaId              String
  /// Código de ARCA: 1 Factura A, 6 Factura B, 3 Nota de crédito A, 8 Nota de crédito B.
  tipo                 Int
  puntoVenta           Int
  /// false = homologación: el CAE no vale como factura real.
  produccion           Boolean
  /// 80 CUIT, 99 consumidor final sin identificar.
  docTipo              Int
  docNro               String
  /// 1 responsable inscripto, 5 consumidor final, 6 monotributo.
  condicionIvaReceptor Int
  neto                 Float
  iva                  Float
  total                Float
  /// La factura que anula esta nota de crédito.
  anula                ComprobanteFiscal?  @relation("NotaDeCredito", fields: [anulaId], references: [id])
  anulaId              String?
  notasDeCredito       ComprobanteFiscal[] @relation("NotaDeCredito")
  /// Lo que devolvió ARCA. Sin CAE = pendiente.
  numero               Int?
  cae                  String?
  caeVence             DateTime?           @db.Date
  emitidoEn            DateTime?
  error                String?
  /// Marca de quién lo está pidiendo ahora, para no pedir dos veces el mismo.
  intentandoEn         DateTime?
  creadoEn             DateTime            @default(now())

  @@index([ventaId])
  @@index([cae])
}

// ─── Recetas y stock (ventas beta) ──────────────────────────────────────────

enum UnidadIngrediente {
  G
  ML
  U
}

enum TipoMovimientoStock {
  /// Un conteo físico: fija el stock en lo contado.
  CONTEO
  /// Mercadería que entró (una compra, una transferencia de otro local).
  INGRESO
  /// Lo que salió sin venderse: merma, consumo del personal, rotura.
  EGRESO
}

/// Lo que se usa para hacer los productos: café en gramos, leche en ml,
/// medialunas en unidades. El costo es por unidad (por gramo, ml o unidad).
model Ingrediente {
  id          String            @id @default(cuid())
  local       Local             @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId     String
  nombre      String
  unidad      UnidadIngrediente
  /// Clave del insumo de lib/compras/recetas.ts: si está, el costo sale de la
  /// última factura del proveedor y se actualiza solo. Si no, manda `costo`.
  insumo      String?
  /// Costo neto por unidad cargado a mano (se usa si no hay insumo vinculado).
  costo       Float             @default(0)
  stockMinimo Float?
  activo      Boolean           @default(true)
  recetas     RecetaItem[]
  movimientos MovimientoStock[]
  createdAt   DateTime          @default(now())

  @@unique([localId, nombre])
}

/// Un renglón de la receta de un producto: cuánto de cada ingrediente lleva.
model RecetaItem {
  id            String        @id @default(cuid())
  producto      ProductoVenta @relation(fields: [productoId], references: [id], onDelete: Cascade)
  productoId    String
  ingrediente   Ingrediente   @relation(fields: [ingredienteId], references: [id], onDelete: Restrict)
  ingredienteId String
  cantidad      Float

  @@unique([productoId, ingredienteId])
  @@index([ingredienteId])
}

/// Movimientos manuales de stock. Lo que consumen las ventas no se guarda:
/// se calcula de las ventas cerradas y sus recetas desde el último conteo,
/// así una venta anulada deja de descontar sola.
model MovimientoStock {
  id            String              @id @default(cuid())
  ingrediente   Ingrediente         @relation(fields: [ingredienteId], references: [id], onDelete: Cascade)
  ingredienteId String
  tipo          TipoMovimientoStock
  /// En la unidad del ingrediente. En un CONTEO es lo contado.
  cantidad      Float
  motivo        String?
  /// Quién lo cargó (el nombre, como quedó en ese momento).
  autor         String
  createdAt     DateTime            @default(now())

  @@index([ingredienteId, createdAt])
}

/// Un descuento predefinido del local, como en Fudo: "Empleado 50%",
/// "Cortesía 100%", "Cumpleaños $5.000". Porcentaje (con tope opcional) o
/// monto fijo; se aplica a la venta entera o a un producto.
model DescuentoPlantilla {
  id         String   @id @default(cuid())
  local      Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId    String
  nombre     String
  porcentaje Float?
  monto      Float?
  /// Máximo que puede descontar un porcentaje.
  tope       Float?
  activo     Boolean  @default(true)
  orden      Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([localId, nombre])
}

enum EstadoCocina {
  PENDIENTE
  PREPARANDO
  LISTO
  ENTREGADO
}

/// La libreta de clientes del local: datos para facturar, un descuento propio
/// y la cuenta corriente (lo que se cobró "a cuenta" menos lo que pagó).
model Cliente {
  id           String        @id @default(cuid())
  local        Local         @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId      String
  nombre       String
  telefono     String?
  email        String?
  /// CUIT o DNI.
  documento    String?
  direccion    String?
  descuentoPct Float?
  notas        String?
  activo       Boolean       @default(true)
  creadoEn     DateTime      @default(now())
  ventas       Venta[]
  pagos        PagoCliente[]
  reservas     Reserva[]

  @@index([localId, nombre])
}

/// Un pago del cliente que baja su cuenta corriente.
model PagoCliente {
  id        String   @id @default(cuid())
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String
  monto     Float
  nota      String?
  creadoEn  DateTime @default(now())

  @@index([clienteId])
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  SENTADA
  CANCELADA
  NO_VINO
}

model Reserva {
  id         String        @id @default(cuid())
  local      Local         @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId    String
  /// Día y hora de llegada.
  fecha      DateTime
  personas   Int
  nombre     String
  telefono   String?
  cliente    Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  clienteId  String?
  mesa       Mesa?         @relation(fields: [mesaId], references: [id], onDelete: SetNull)
  mesaId     String?
  comentario String?
  estado     EstadoReserva @default(PENDIENTE)
  creadaEn   DateTime      @default(now())

  @@index([localId, fecha])
}
